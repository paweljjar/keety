import ui;
import "time";
from http import app, cors, recover;
from "io" import println;
import "./Counter.kml";

fn main(): void {
    println("=======================================================");
    println("       KeetScript Reactive UI Engine Web Server        ");
    println("=======================================================");
    println("");

    let server: HttpServer = app();

    // Register standard middlewares
    server.use(cors());
    server.use(recover());

    // Serve reactive Counter UI on root and /counter
    server.serveUi("/", fn(): Counter {
        return Counter();
    }, "KeetScript Reactive UI Demo");

    server.serveUi("/counter", fn(): Counter {
        return Counter();
    }, "KeetScript Reactive UI Demo");

    let port: int = 3000;
    server.listen(port);

    println("[+] HTTP & WebSocket server is running!");
    println("    --> Local website:  http://localhost:3000");
    println("    --> Counter route:  http://localhost:3000/counter");
    println("    --> VDOM Client JS: http://localhost:3000/_keet/vdom.js");
    println("    --> Live WS Bridge: ws://localhost:3000/_keet_ws");
    println("");
    println("Interactive real-time updates are active over WebSocket.");
    println("Press Ctrl+C to terminate the server.");
    println("");

    while (server.isRunning()) {
        time.sleepMs(500);
    }
}
